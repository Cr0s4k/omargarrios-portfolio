---
import { Languages } from '@lucide/astro';
import type { PortfolioData } from '../data/portfolio';
interface Props { languages: PortfolioData['personal']['languages']; }
const { languages } = Astro.props;
---
<section aria-labelledby="languages-heading" class="space-y-4 break-inside-avoid">
  <div class="flex items-center gap-2 text-zinc-900 dark:text-white font-bold tracking-tight text-xl">
    <Languages class="w-4 h-4" />
    <h2 id="languages-heading">Languages</h2>
  </div>
  <dl class="space-y-3 text-sm">
    {languages.map(lang => <div class="flex flex-wrap items-baseline justify-between gap-x-4 gap-y-1">
      <dt class="font-medium text-zinc-800 dark:text-zinc-200">{lang.name}</dt>
      <dd class="text-zinc-600 dark:text-zinc-400">{lang.level}</dd>
    </div>)}
  </dl>
</section>
