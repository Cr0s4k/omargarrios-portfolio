---
import { GraduationCap } from '@lucide/astro';
import type { Education as EducationType } from '../data/portfolio';

interface Props {
  education: EducationType[];
}

const { education } = Astro.props;
---

<section id="education" class="space-y-4 break-inside-avoid">
  <div class="flex items-center gap-2 text-zinc-900 dark:text-white font-bold tracking-tight text-xl">
    <GraduationCap class="w-4 h-4" />
    <h2>Education</h2>
  </div>

  <div class="space-y-3">
    {education.map(edu => (
      <div class="p-5 rounded-2xl bg-white dark:bg-zinc-900/60 border border-zinc-200/90 dark:border-zinc-800/80 shadow-xs print-clean-container">
        <div class="flex flex-col sm:flex-row sm:items-baseline sm:justify-between gap-1 mb-1">
          <h3 class="text-base font-bold text-zinc-900 dark:text-white">
            {edu.degree}
          </h3>
          {edu.period && (
            <span class="text-xs font-mono text-zinc-500 dark:text-zinc-400 whitespace-nowrap">
              {edu.period}
            </span>
          )}
        </div>
        {edu.specialization && (
          <div class="text-xs sm:text-sm font-medium text-sky-600 dark:text-sky-400 mb-1">
            {edu.specialization}
          </div>
        )}
        <div class="text-xs sm:text-sm text-zinc-600 dark:text-zinc-300">
          {edu.institution} · {edu.location}
        </div>
      </div>
    ))}
  </div>
</section>
