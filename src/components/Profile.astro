---
import type { PortfolioData } from '../data/portfolio';
interface Props { about: PortfolioData['personal']['about']; }
const { about } = Astro.props;
---
<section id="profile" aria-label="About Omar" class="max-w-3xl space-y-3 text-base leading-relaxed text-zinc-600 dark:text-zinc-300">
  {about.paragraphs.map(paragraph => <p>{paragraph}</p>)}
</section>
